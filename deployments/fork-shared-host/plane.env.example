# plane-evo shared-host env for 13.140.219.161 / plane.evotechly.com
# Copy to plane.env on the host. Do not commit plane.env.
# This file contains NO secrets. Operator must fill every REPLACE_* value
# on the VPS (this task does not generate or expose secrets).

# --- Pin (images are tagged with this; run.sh sets it from git HEAD if unset) ---
PLANE_IMAGE_TAG=REPLACE_WITH_GIT_SHA12
APP_DOMAIN=plane.evotechly.com
APP_RELEASE=fork

# --- Public URL (nginx terminates TLS; Plane Caddy is HTTP on loopback) ---
WEB_URL=https://plane.evotechly.com
CORS_ALLOWED_ORIGINS=https://plane.evotechly.com
DEBUG=0

# Loopback published by compose. Do not use 80, 443, 4007, or 8080.
LISTEN_HTTP_PORT=18080
SITE_ADDRESS=:80
# Leave HTTPS unset so the bundled Caddy does not claim 443.
LISTEN_HTTPS_PORT=
CERT_EMAIL=
CERT_ACME_CA=
CERT_ACME_DNS=

# nginx (host) + bundled Caddy (container) sit in front of the API.
NUM_PROXIES=2
TRUSTED_PROXIES=private_ranges

# --- Secrets (operator-generated; refuse placeholders in run.sh) ---
# python3 -c "from django.utils.crypto import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REPLACE_DJANGO_SECRET_KEY
# openssl rand -hex 32
LIVE_SERVER_SECRET_KEY=REPLACE_LIVE_SERVER_SECRET_KEY

# --- Database (internal docker DNS; do not publish 5432) ---
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://plane:REPLACE_POSTGRES_PASSWORD@plane-db:5432/plane

# --- Redis (internal; do not publish 6379) ---
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/
REDIS_SSL_CERT_REQS=required
REDIS_SSL_CA_CERTS=

# --- RabbitMQ (internal; do not publish 5672/15672) ---
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=REPLACE_RABBITMQ_PASSWORD
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:REPLACE_RABBITMQ_PASSWORD@plane-mq:5672/plane

# --- Object storage (bundled MinIO). Access key + secret must match. ---
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=REPLACE_MINIO_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_MINIO_SECRET_KEY
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
MINIO_ENDPOINT_SSL=0

# --- App ---
API_BASE_URL=http://api:8000
LIVE_BASE_PATH=/live
GUNICORN_WORKERS=1
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# Optional: first-run instance defaults (also configurable later in /god-mode/)
ENABLE_SIGNUP=1
ENABLE_EMAIL_PASSWORD=1
ENABLE_MAGIC_LINK_LOGIN=0
ENABLE_SMTP=0
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_FROM=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
